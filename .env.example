# Copy to .env and adjust. Never commit .env.
# npm start and npm run dev load .env automatically when it exists.

# development | test | production
NODE_ENV=development
# Interface and port the HTTP server binds to (use 0.0.0.0 inside containers)
HOST=127.0.0.1
PORT=3000
# debug | info | warn | error | silent
LOG_LEVEL=info
